local function RefreshFlingPlayerList()
    for _, child in ipairs(FlingListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local item = Instance.new("Frame")
            item.Size = UDim2.new(1, 0, 0, 32)
            item.BackgroundColor3 = (SelectedFlingTarget == p) and Color3.fromRGB(30, 35, 52) or Color3.fromRGB(14, 15, 21)
            item.Parent = FlingListScroll

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 5)
            itemCorner.Parent = item

            local avatarImg = Instance.new("ImageLabel")
            avatarImg.Size = UDim2.new(0, 24, 0, 24)
            avatarImg.Position = UDim2.new(0, 5, 0.5, -12)
            avatarImg.BackgroundTransparency = 1
            avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=48&h=48"
            avatarImg.Parent = item

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -110, 1, 0)
            nameLabel.Position = UDim2.new(0, 35, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            nameLabel.Font = Enum.Font.GothamMedium
            nameLabel.TextSize = 11
            nameLabel.TextColor3 = Color3.fromRGB(210, 215, 230)
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = item

            local selectBtn = Instance.new("TextButton")
            selectBtn.Size = UDim2.new(0, 65, 0, 20)
            selectBtn.Position = UDim2.new(1, -70, 0.5, -10)
            selectBtn.BackgroundColor3 = Color3.fromRGB(35, 38, 52)
            selectBtn.Text = (SelectedFlingTarget == p) and "Selected" or "Select"
            selectBtn.Font = Enum.Font.Gotham
            selectBtn.TextSize = 10
            selectBtn.TextColor3 = Color3.fromRGB(230, 230, 245)
            selectBtn.Parent = item

            local selectCorner = Instance.new("UICorner")
            selectCorner.CornerRadius = UDim.new(0, 4)
            selectCorner.Parent = selectBtn

            selectBtn.MouseButton1Click:Connect(function()
                SelectedFlingTarget = p
                TargetInfoLbl.Text = "Selected: " .. p.DisplayName
                RefreshFlingPlayerList()
            end)
        end
    end
end

FlingActionBtn.MouseButton1Click:Connect(function()
    if not SelectedFlingTarget then return end
    Fling_Active = not Fling_Active
    if Fling_Active then
        FlingActionBtn.Text = "STOP FLING"
        FlingActionBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    else
        FlingActionBtn.Text = "START FLING"
        FlingActionBtn.BackgroundColor3 = Color3.fromRGB(80, 110, 245)
    end
end)

Players.PlayerAdded:Connect(RefreshFlingPlayerList)
Players.PlayerRemoving:Connect(function(p)
    if SelectedFlingTarget == p then
        SelectedFlingTarget = nil
        Fling_Active = false
        TargetInfoLbl.Text = "Selected: None"
        FlingActionBtn.Text = "START FLING"
        FlingActionBtn.BackgroundColor3 = Color3.fromRGB(80, 110, 245)
    end
    RefreshFlingPlayerList()
end)
RefreshFlingPlayerList()


local AutoClick_MinDelay = 25
local AutoClick_MaxDelay = 35

local cardAutoMain = CreateCard(autoL, "Auto Clicker Controls")
local autoToggleUpdater = CreateToggle(cardAutoMain, "Auto Clicker (25ms)", AutoClick_Enabled, function(s) AutoClick_Enabled = s end)
CreateToggle(cardAutoMain, "Random Offset (+-35ms)", AutoClick_RandomOffset, function(s) AutoClick_RandomOffset = s end)


