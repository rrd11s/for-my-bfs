local function GetPlayerHealth(player)
    if not player or not player.Character then return 100, 100 end
    local char = player.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    local attrHp = char:GetAttribute("Health") or char:GetAttribute("HP")
    local attrMaxHp = char:GetAttribute("MaxHealth") or char:GetAttribute("MaxHP") or 100
    if attrHp then return math.floor(attrHp), math.floor(attrMaxHp) end
    
    local valHp = char:FindFirstChild("Health") or char:FindFirstChild("HP")
    local valMaxHp = char:FindFirstChild("MaxHealth") or char:FindFirstChild("MaxHP")
    if valHp and (valHp:IsA("NumberValue") or valHp:IsA("IntValue")) then
        local maxVal = (valMaxHp and (valMaxHp:IsA("NumberValue") or valMaxHp:IsA("IntValue"))) and valMaxHp.Value or 100
        return math.floor(valHp.Value), math.floor(maxVal)
    end
    
    if hum then return math.floor(hum.Health), math.floor(hum.MaxHealth) end
    return 100, 100
end

local StatsGui = Instance.new("ScreenGui")
StatsGui.Name = "VerolixStats"
StatsGui.ResetOnSpawn = false
StatsGui.Parent = PlayerGui

