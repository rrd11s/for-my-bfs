local BannedUsers = {"none", "none"}

local function IsBannedUser(player)
    for _, name in ipairs(BannedUsers) do
        if string.lower(player.Name) == string.lower(name) or string.lower(player.DisplayName) == string.lower(name) then
            return true
        end
    end
    return false
end

if IsBannedUser(LocalPlayer) then
    LocalPlayer:Kick("Banned")
    return
end

local Master_Enabled = true
local ESP_Enabled = true
local Health_Enabled = true
local AntiLag_Enabled = false

local Lock_Enabled = true
local Lock_Friends = false
local Lock_Key = Enum.KeyCode.Q
local LockedTarget = nil

local Lock_TargetPart = "HumanoidRootPart"
local Lock_Smoothness = false
local Lock_SmoothAmount = 0.3
local Lock_Prediction = false

local AutoClick_Enabled = false
local AutoClick_RandomOffset = true

local AntiFling_Enabled = false
local Fling_Active = false
local SelectedFlingTarget = nil

