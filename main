    Master_Enabled = s
    if not s then LockedTarget = nil Fling_Active = false end
    RefreshAllESP()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.E then
        AutoClick_Enabled = not AutoClick_Enabled
        autoToggleUpdater(AutoClick_Enabled)
    elseif input.KeyCode == Lock_Key then
        if not Master_Enabled or not Lock_Enabled then return end
        if LockedTarget then LockedTarget = nil else LockedTarget = GetClosestTarget() end
    elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

local macroL, macroR = CreateTab("Macro", 5)


NavButtons["Settings"].Btn.LayoutOrder = 6

local Macro_Key = Enum.KeyCode.F
local Macro_ToggleKey = Enum.KeyCode.Zero
local Macro_Delay = 25
local Macro_Enabled = false

local function KeyCodeFromText(text, fallback)
    local key
    pcall(function()
        key = Enum.KeyCode[string.upper(text)]
    end)

    if key then
        return key
    end

    return fallback
end

local macroControls = CreateCard(macroL, "Macro Controls")

CreateButton(macroControls, "Macro Key", Macro_Key.Name, function(btn)
    local current = Macro_Key.Name

    local popup = Instance.new("TextBox")
    popup.Size = UDim2.new(0, 100, 0, 25)
    popup.Position = UDim2.new(1, -100, 0, 0)
    popup.BackgroundColor3 = Color3.fromRGB(30, 32, 44)
    popup.TextColor3 = Color3.fromRGB(255, 255, 255)
    popup.Text = current
    popup.ClearTextOnFocus = false
    popup.Font = Enum.Font.GothamMedium
    popup.TextSize = 10
    popup.Parent = btn.Parent

    popup.FocusLost:Connect(function()
        Macro_Key = KeyCodeFromText(popup.Text, Macro_Key)
        btn.Text = Macro_Key.Name
        popup:Destroy()
    end)
end)

CreateButton(macroControls, "Toggle Key", Macro_ToggleKey.Name, function(btn)
    local current = Macro_ToggleKey.Name

    local popup = Instance.new("TextBox")
    popup.Size = UDim2.new(0, 100, 0, 25)
    popup.Position = UDim2.new(1, -100, 0, 0)
    popup.BackgroundColor3 = Color3.fromRGB(30, 32, 44)
    popup.TextColor3 = Color3.fromRGB(255, 255, 255)
    popup.Text = current
    popup.ClearTextOnFocus = false
    popup.Font = Enum.Font.GothamMedium
    popup.TextSize = 10
    popup.Parent = btn.Parent

    popup.FocusLost:Connect(function()
        Macro_ToggleKey = KeyCodeFromText(popup.Text, Macro_ToggleKey)
        btn.Text = Macro_ToggleKey.Name
        popup:Destroy()
    end)
end)


