RunService.RenderStepped:Connect(function(dt)
    CurrentFPS = math.floor(1 / dt)
    if Master_Enabled then
        StatsLabel.Text = "FPS: " .. CurrentFPS .. " | Ping: " .. CurrentPing .. " ms | Auto: " .. (AutoClick_Enabled and "ON" or "OFF")
        StatsLabel.Visible = true
    else
        StatsLabel.Visible = false
    end
end)

task.spawn(function()
    while task.wait(1) do
        pcall(function()
            CurrentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
    end
end)

task.spawn(function()
    while true do
        if Master_Enabled and AutoClick_Enabled then
            pcall(function()
                if mouse1click then
                    mouse1click()
                else
                    VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 1)
                    task.wait(0.005)
                    VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 1)
                end
            end)
            local delayTime = 0.025
            if AutoClick_RandomOffset then
                delayTime = math.max(0.005, delayTime + (math.random(-35, 35) / 1000))
            end
            task.wait(delayTime)
        else
            task.wait(0.1)
        end
    end
end)

RunService.Stepped:Connect(function()
    if Master_Enabled and AntiFling_Enabled and LocalPlayer.Character then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in ipairs(p.Character:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            if root.AssemblyLinearVelocity.Magnitude > 250 then root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
            if root.AssemblyAngularVelocity.Magnitude > 250 then root.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if Master_Enabled and Fling_Active and SelectedFlingTarget and SelectedFlingTarget.Character and LocalPlayer.Character then
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetRoot = SelectedFlingTarget.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and targetRoot then
            myRoot.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 0)
        end
    end
end)

local function GetPlayerColor(player)
    local isFriend = false
    pcall(function() isFriend = LocalPlayer:IsFriendsWith(player.UserId) end)
    return isFriend and _G.FriendColor or _G.EnemyColor
end

local function GetClosestTarget()
    local closest = nil
    local maxDist = 1000
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hp, _ = GetPlayerHealth(p)
            if hp > 0 then
                local isFriend = false
                pcall(function() isFriend = LocalPlayer:IsFriendsWith(p.UserId) end)
                if not isFriend or Lock_Friends then
                    local root = p.Character.HumanoidRootPart
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < maxDist then
                            maxDist = dist
                            closest = p
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function UpdateTargetESP(player)
    local charHolder = Holder:FindFirstChild(player.Name .. "_ESP")
    if not charHolder then return end

    local glow = charHolder:FindFirstChild("Glow")
    local tag = charHolder:FindFirstChild("NameTag")
    local label = tag and tag:FindFirstChildOfClass("TextLabel")

    local isVisible = Master_Enabled and ESP_Enabled
    local pColor = GetPlayerColor(player)

    if glow then
        glow.Enabled = isVisible
        glow.FillColor = pColor
        glow.OutlineColor = pColor
        glow.FillTransparency = AntiLag_Enabled and 0.85 or 0.5
        glow.OutlineTransparency = AntiLag_Enabled and 1 or 0
    end

    if tag then tag.Enabled = isVisible end

    if label and player.Character then
        local hp, _ = GetPlayerHealth(player)
        label.TextColor3 = pColor 
        label.Font = FontPresets[currentFontIdx].Font
        label.Text = Health_Enabled and (player.DisplayName .. " (@" .. player.Name .. ") | " .. hp .. " HP") or (player.DisplayName .. " (@" .. player.Name .. ")")
    end
end

local function RefreshAllESP()
    for _, charHolder in ipairs(Holder:GetChildren()) do
        local pName = string.sub(charHolder.Name, 1, #charHolder.Name - 4)
        local p = Players:FindFirstChild(pName)
        if p then UpdateTargetESP(p) end
    end
end

local function LoadCharacter(player, character)
    if player == LocalPlayer or not character then return end

    local head = character:FindFirstChild("Head")
    local hum = character:FindFirstChildOfClass("Humanoid")
    local timer = 0
    while (not head or not hum) and timer < 10 do
        task.wait(0.3)
        head = character:FindFirstChild("Head")
        hum = character:FindFirstChildOfClass("Humanoid")
        timer = timer + 0.3
    end
    if not head or not hum then return end

    local pColor = GetPlayerColor(player)

    local oldHolder = Holder:FindFirstChild(player.Name .. "_ESP")
    if oldHolder then oldHolder:Destroy() end

    local charHolder = Instance.new("Folder")
    charHolder.Name = player.Name .. "_ESP"
    charHolder.Parent = Holder

    local highlight = Instance.new("Highlight")
    highlight.Name = "Glow"
    highlight.Adornee = character
    highlight.FillColor = pColor
    highlight.OutlineColor = pColor
    highlight.FillTransparency = AntiLag_Enabled and 0.85 or 0.5
    highlight.OutlineTransparency = AntiLag_Enabled and 1 or 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = Master_Enabled and ESP_Enabled
    highlight.Parent = charHolder

    local nameTag = Instance.new("BillboardGui")
    nameTag.Name = "NameTag"
    nameTag.Size = UDim2.new(0, 160, 0, 35)
    nameTag.AlwaysOnTop = true
    nameTag.StudsOffset = Vector3.new(0, 2.5, 0)
    nameTag.Adornee = head
    nameTag.Enabled = Master_Enabled and ESP_Enabled

    local tagLabel = Instance.new("TextLabel")
    tagLabel.BackgroundTransparency = 1
    tagLabel.Size = UDim2.new(1, 0, 1, 0)
    tagLabel.TextSize = 12
    tagLabel.Font = FontPresets[currentFontIdx].Font
    tagLabel.TextColor3 = pColor
    tagLabel.TextStrokeTransparency = 0.2
    tagLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    tagLabel.Parent = nameTag

    nameTag.Parent = charHolder

    UpdateTargetESP(player)

    hum.HealthChanged:Connect(function()
        if Health_Enabled then UpdateTargetESP(player) end
    end)
end

local function LoadPlayer(player)
    if player == LocalPlayer then return end
    if player.Character then task.spawn(LoadCharacter, player, player.Character) end
    player.CharacterAdded:Connect(function(char) task.spawn(LoadCharacter, player, char) end)
end

for _, player in ipairs(Players:GetPlayers()) do LoadPlayer(player) end
Players.PlayerAdded:Connect(LoadPlayer)
Players.PlayerRemoving:Connect(function(player)
    local oldHolder = Holder:FindFirstChild(player.Name .. "_ESP")
    if oldHolder then oldHolder:Destroy() end
end)

RunService.RenderStepped:Connect(function()
    if Master_Enabled and Lock_Enabled and LockedTarget and LockedTarget.Character then
        local targetPart = LockedTarget.Character:FindFirstChild(Lock_TargetPart) or LockedTarget.Character:FindFirstChild("HumanoidRootPart")
        local hp, _ = GetPlayerHealth(LockedTarget)
        if targetPart and hp > 0 then
            local targetPos = targetPart.Position
            if Lock_Prediction then
                targetPos = targetPos + (targetPart.AssemblyLinearVelocity * 0.12)
            end
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
            if Lock_Smoothness then
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Lock_SmoothAmount)
            else
                Camera.CFrame = targetCFrame
            end
        else
            LockedTarget = nil
        end
    else
        LockedTarget = nil
    end
end)

