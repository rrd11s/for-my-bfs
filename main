local function CreateToggle(parent, labelText, initialState, callback)
    local itemFrame = Instance.new("Frame")
    itemFrame.Size = UDim2.new(1, 0, 0, 24)
    itemFrame.BackgroundTransparency = 1
    itemFrame.Parent = parent

    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(0.65, 0, 1, 0)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = labelText
    textLbl.Font = Enum.Font.GothamMedium
    textLbl.TextSize = 11
    textLbl.TextColor3 = Color3.fromRGB(200, 205, 220)
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.Parent = itemFrame

    local switchBtn = Instance.new("TextButton")
    switchBtn.Size = UDim2.new(0, 32, 0, 16)
    switchBtn.Position = UDim2.new(1, -32, 0.5, -8)
    switchBtn.BackgroundColor3 = initialState and Color3.fromRGB(80, 110, 245) or Color3.fromRGB(35, 38, 50)
    switchBtn.Text = ""
    switchBtn.AutoButtonColor = false
    switchBtn.Parent = itemFrame

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBtn

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 10, 0, 10)
    knob.Position = initialState and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 3, 0.5, -5)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = switchBtn

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local currState = initialState

    switchBtn.MouseButton1Click:Connect(function()
        currState = not currState
        TweenService:Create(switchBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = currState and Color3.fromRGB(80, 110, 245) or Color3.fromRGB(35, 38, 50)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = currState and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 3, 0.5, -5)
        }):Play()
        callback(currState)
    end)

    return function(newState)
        currState = newState
        TweenService:Create(switchBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = currState and Color3.fromRGB(80, 110, 245) or Color3.fromRGB(35, 38, 50)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = currState and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 3, 0.5, -5)
        }):Play()
    end
end

