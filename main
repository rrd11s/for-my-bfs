local hitboxStatusCard = CreateCard(hitL, "Status")

local statusHitboxLabel = Instance.new("TextLabel")
statusHitboxLabel.Size = UDim2.new(1, 0, 0, 24)
statusHitboxLabel.BackgroundTransparency = 1
statusHitboxLabel.Text = "Hitbox Status: OFF"
statusHitboxLabel.Font = Enum.Font.GothamBold
statusHitboxLabel.TextSize = 11
statusHitboxLabel.TextColor3 = Color3.fromRGB(150, 155, 175)
statusHitboxLabel.TextXAlignment = Enum.TextXAlignment.Left
