local customSpeedBtn = CreateButton(cardAutoSpeed, "Custom Speed", tostring(AutoClick_MinDelay) .. "ms", function(btn)
    local popup = Instance.new("TextBox")
    popup.Size = UDim2.new(0, 100, 0, 25)
    popup.Position = UDim2.new(1, -100, 0, 0)
    popup.BackgroundColor3 = Color3.fromRGB(30, 32, 44)
    popup.TextColor3 = Color3.fromRGB(255, 255, 255)
    popup.Text = tostring(AutoClick_MinDelay)
    popup.ClearTextOnFocus = false
    popup.Font = Enum.Font.GothamMedium
    popup.TextSize = 10
    popup.Parent = btn.Parent

    popup.FocusLost:Connect(function()
        local val = tonumber(popup.Text)
        if val then
           
            AutoClick_MinDelay = math.max(0, val)
            AutoClick_MaxDelay = AutoClick_MinDelay + 10
            btn.Text = tostring(AutoClick_MinDelay) .. "ms"
        end
        popup:Destroy()
    end)
end)


CreateButton(cardAutoSpeed, "Reset to Default", "25 - 35ms", function(btn)
    AutoClick_MinDelay = 25
    AutoClick_MaxDelay = 35
    

    if customSpeedBtn then
        customSpeedBtn.Text = "25ms"
    end
end)



