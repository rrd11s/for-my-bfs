UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Macro_ToggleKey then
        Macro_Enabled = not Macro_Enabled

        statusLabel.Text = "Macro Status: " .. (Macro_Enabled and "ON" or "OFF")
        statusLabel.TextColor3 =
            Macro_Enabled
            and Color3.fromRGB(80, 220, 120)
            or Color3.fromRGB(150, 155, 175)
    end
end)


task.spawn(function()
    while true do
        if Macro_Enabled and Master_Enabled then
            pcall(function()
                VirtualInputManager:SendKeyEvent(
                    true,
                    Macro_Key,
                    false,
                    game
                )

                task.wait(0.001)

                VirtualInputManager:SendKeyEvent(
                    false,
                    Macro_Key,
                    false,
                    game
                )
            end)

            task.wait(math.max(0, Macro_Delay) / 1000)
        else
            task.wait(0.1)
        end
    end
end)


