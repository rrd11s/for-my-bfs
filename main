local function CreateTab(tabName, layoutOrder)
    local navBtn = Instance.new("TextButton")
    navBtn.Size = UDim2.new(1, 0, 0, 32)
    navBtn.BackgroundColor3 = Color3.fromRGB(22, 24, 33)
    navBtn.BackgroundTransparency = 1
    navBtn.Text = "  " .. tabName
    navBtn.Font = Enum.Font.GothamMedium
    navBtn.TextSize = 12
    navBtn.TextColor3 = Color3.fromRGB(130, 135, 155)
    navBtn.TextXAlignment = Enum.TextXAlignment.Left
    navBtn.LayoutOrder = layoutOrder
    navBtn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = navBtn

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 16)
    indicator.Position = UDim2.new(0, 0, 0.5, -8)
    indicator.BackgroundColor3 = Color3.fromRGB(80, 110, 245)
    indicator.BorderSizePixel = 0
    indicator.BackgroundTransparency = 1
    indicator.Parent = navBtn

    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 2)
    indCorner.Parent = indicator

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.BorderSizePixel = 0
    tabFrame.ScrollBarThickness = 2
    tabFrame.ScrollBarImageColor3 = Color3.fromRGB(45, 50, 70)
    tabFrame.Visible = false
    tabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabFrame.Parent = ContentArea

    local colLeft = Instance.new("Frame")
    colLeft.Size = UDim2.new(0.49, -4, 1, 0)
    colLeft.BackgroundTransparency = 1
    colLeft.Parent = tabFrame

    local leftLayout = Instance.new("UIListLayout")
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Padding = UDim.new(0, 10)
    leftLayout.Parent = colLeft

    local colRight = Instance.new("Frame")
    colRight.Size = UDim2.new(0.49, -4, 1, 0)
    colRight.Position = UDim2.new(0.51, 0, 0, 0)
    colRight.BackgroundTransparency = 1
    colRight.Parent = tabFrame

    local rightLayout = Instance.new("UIListLayout")
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Padding = UDim.new(0, 10)
    rightLayout.Parent = colRight

    Tabs[tabName] = {Frame = tabFrame, Left = colLeft, Right = colRight}
    NavButtons[tabName] = {Btn = navBtn, Indicator = indicator}

    navBtn.MouseButton1Click:Connect(function()
        for name, data in pairs(Tabs) do
            local isTarget = (name == tabName)
            data.Frame.Visible = isTarget
            local btnData = NavButtons[name]
            TweenService:Create(btnData.Btn, TweenInfo.new(0.18), {
                TextColor3 = isTarget and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 135, 155),
                BackgroundTransparency = isTarget and 0 or 1,
                BackgroundColor3 = isTarget and Color3.fromRGB(24, 26, 36) or Color3.fromRGB(22, 24, 33)
            }):Play()
            TweenService:Create(btnData.Indicator, TweenInfo.new(0.18), {
                BackgroundTransparency = isTarget and 0 or 1
            }):Play()
        end
    end)

    return colLeft, colRight, tabFrame
end

